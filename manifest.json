{
    "manifest_version": 3,
    "name": "MicroMacroManager",
    "version": "1.0.0",
    "description": "Floating macro manager for idle and browser games — auto-clicker, hotkeys, keystroke sequences, and position clickers.",

    "browser_specific_settings": {
        "gecko": {
            "id": "micromacro-manager@local",
            "data_collection_permissions": {
                "required": ["none"],
                "optional": []
            }
        }
    },

    "icons": {
        "16":  "icons/icon16.png",
        "32":  "icons/icon32.png",
        "48":  "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "permissions": ["storage", "tabs"],

    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "MicroMacroManager",
        "default_icon": {
            "16":  "icons/icon16.png",
            "32":  "icons/icon32.png",
            "48":  "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
